# Every variable is optional; the values below are the defaults.
PORT=3000
LOG_LEVEL=info  # fatal | error | warn | info | debug | trace | silent
PROVIDER_TIMEOUT_MS=3000
REQUEST_BUDGET_MS=7000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# New Relic stays off without a license key.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=zip-code-lookup
