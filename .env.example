# Every variable is optional; the values below are the defaults.
PORT=3000
LOG_LEVEL=info  # fatal | error | warn | info | debug | trace | silent
PROVIDER_TIMEOUT_MS=3000
REQUEST_BUDGET_MS=7000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000
CACHE_FRESH_MS=86400000           # 24h served as current
CACHE_EXPIRED_WINDOW_MS=604800000 # 7 days from storage, then gone; longer than CACHE_FRESH_MS
CACHE_ABSENCE_TTL_MS=3600000      # 1h for a confirmed absence
CACHE_MAX_ENTRIES=10000           # least recently used goes first

# New Relic stays off without a license key.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=zip-code-lookup
